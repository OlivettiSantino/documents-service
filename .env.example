# Configuracion 12-Factor: todo por variables de entorno, sin secretos en el repo.
# Copiado tal cual sirve para Docker (docker compose lee este .env) y para
# correr local:  uv run --env-file .env python -m app
#
# Las lineas comentadas "solo para uv run" ya son los defaults de Settings: con
# uv run no hace falta descomentarlas. Descomentarlas solo para cambiar el
# valor, y entonces ese .env deja de servir para Docker: el compose interpola
# esas variables desde el .env y un valor de aca pisa su default.

# --- proceso ---
HOST=0.0.0.0
# Puerto del proceso. En el host solo se usa al correr con `uv run`. En Docker
# el contenedor escucha siempre en 8002 y no se publica: se entra por Traefik
# (http://127.0.0.1:8080/documents).
PORT=8002
LOG_LEVEL=INFO
# Solo para uv run (ver arriba). En Docker el compose usa json.
#LOG_FORMAT=text

# --- base de datos propia (database per service) ---
# No apuntar nunca a pdf_extract_db: el servicio se niega a arrancar.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=documents_db
MONGO_TIMEOUT_MS=3000
# Con Mongo caido: 503 a los MONGO_TIMEOUT_MS, con Retry-After de estos segundos.
MONGO_RETRY_AFTER=5

# --- red compartida ---
# COMPARTIDA con pdf_extractext-infra y extract-service: mismo nombre en los
# tres repos. Crearla una sola vez por maquina:  docker network create mired
SHARED_NETWORK=mired

# --- COMPARTIDA: service discovery con Consul ---
# Activa el registro de este servicio, con los tags que lo publican en Traefik.
# No cambia a donde se llama a extract: eso es siempre EXTRACT_URL.
# Solo para uv run (ver arriba). En Docker el compose lo enciende (true): un
# false aca haria que documents no se registre en Consul.
#CONSUL_ENABLED=false
CONSUL_HTTP_ADDR=http://consul:8500
# Token de ACL: el valor de CONSUL_DOCUMENTS_TOKEN del .env de infra (no el de
# management). Nunca commitearlo: dejarlo vacio aca y completarlo solo en el
# .env local. No exportarlo en el shell: Compose le da prioridad al shell sobre
# el .env. Vacio o equivocado, Consul rechaza el registro (403) y Traefik no
# rutea a documents.
CONSUL_HTTP_TOKEN=
CONSUL_TIMEOUT=2.0

# --- extract-service ---
# Base, SIN "/extract" (el cliente lo agrega).
# En Docker, el compose usa por default el gateway en mired: http://traefik
# Rollback en Docker (directo a extract, sin Traefik): http://extract:8001
# Solo para uv run (ver arriba), con extract corriendo con uv: http://localhost:8001
# Solo para uv run, pasando por Traefik (puerto publicado por infra):
#   http://localhost:8080
# Con Docker, un localhost aca apunta al propio contenedor de documents y todo
# POST /documents responde 503.
#EXTRACT_URL=http://localhost:8001
# Presupuesto de timeouts: cliente 30 s > documents 27 s > Traefik 25 s
EXTRACT_TIMEOUT=27.0
EXTRACT_CONNECT_TIMEOUT=2.0

# --- imagen (solo docker compose -f docker-compose.yml) ---
# Tag de ghcr.io/olivettisantino/documents-service que corre el compose base.
# Vacio o latest en desarrollo; un sha-xxxxxxx o vX.Y.Z para una release
# reproducible. Con el override (docker compose sin -f, o make up de infra) no
# se usa: ahi se compila local como documents-service:dev.
DOCUMENTS_IMAGE_TAG=

# --- escalado horizontal (solo docker compose) ---
# Cantidad de contenedores de documents. Cada uno se registra en Consul con su
# hostname y Traefik balancea entre ellos. La admision total pasa a ser
# DOCUMENTS_REPLICAS x MAX_CONCURRENT_UPLOADS, y la memoria,
# DOCUMENTS_REPLICAS x DOCUMENTS_MEMORY.
DOCUMENTS_REPLICAS=1

# --- limites de entrada ---
MAX_UPLOAD_SIZE=52428800
# Tope del texto extraido, en bytes UTF-8 (15 MiB). Debe ser > 0 y < 16 MiB
# (limite de un documento BSON) o el servicio no arranca. Si se supera -> 422.
MAX_CONTENT_BYTES=15728640
# Control de admision: uploads retenidos en memoria a la vez, POR PROCESO (por
# replica). Sin cupo en UPLOAD_SLOT_TIMEOUT segundos -> 503 con Retry-After.
MAX_CONCURRENT_UPLOADS=4
UPLOAD_SLOT_TIMEOUT=2.0

# Circuit breaker, retry y limite de concurrencia hacia extract: no se
# configuran aca. Los aplica Traefik con los middlewares de los tags de
# extract-service (issue #28).
